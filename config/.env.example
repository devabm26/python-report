# ============================================================
# Thoughts Dashboard – Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real credentials to source control.
# In production, inject these via Kubernetes Secrets or Vault.
# ============================================================

# --- Flask ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string

# Debug mode — set to "true" only in development, NEVER in production
FLASK_DEBUG=false

# --- Database (PostgreSQL) ---
DB_HOST=postgresql.thoughts-app.svc.cluster.local
DB_PORT=5432
DB_NAME=thoughts
DB_USER=thoughts
# DB_PASSWORD must be set — never put the real value in this example file
DB_PASSWORD=

# --- Connection Pool ---
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT=30

# --- Pagination ---
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# --- Server ---
PORT=8000
